# Required for the automatic Live analysis path. The key stays server-side.
# The provider defaults to gemini-3.5-flash-lite (can be overridden via GEMINI_MODEL).
# Supported models: gemini-3.5-flash-lite, gemini-2.5-flash, gemini-2.0-flash, etc.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Required only for Web-assisted Model Runs. Tavily receives sanitized public
# queries and official-domain filters; Gemini remains the document analyst.
TAVILY_API_KEY=""

# Optional. Defaults to 3000.
PORT=3000
